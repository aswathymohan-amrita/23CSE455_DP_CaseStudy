class "getUserSubscriptionPlan / checkout" as SRV <<server>>
UI --> PC : derive + icons
SV --> PC : derive + price ids
SV --> ENV : STRIPE_*_PRICE_ID
BillingForm --> UI
SRV --> SV
@enduml
