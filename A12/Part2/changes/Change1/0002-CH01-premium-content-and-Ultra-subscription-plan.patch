+
+/**
+ * CH01: second link of the chain. Loads the caller's active plan once per request and
+ * exposes its entitlements (tier, profile limit) to resolvers. No plan => tier 0.
+ */
+const attachSubscription = t.middleware(async ({ ctx, next }) => {
+  const userId = ctx.session?.user?.id
+  const plan = userId ? await getUserSubscriptionPlan(userId, ctx.prisma) : null
+  return next({
+    ctx: {
+      subscription: plan,
+      planTier: plan?.tier ?? 0,
+      maxProfiles: plan?.maxProfiles ?? DEFAULT_MAX_PROFILES,
+    },
+  })
+})
+
+/** Signed-in procedure that also knows the caller's plan entitlements. */
+export const subscribedProcedure = protectedProcedure.use(attachSubscription)
