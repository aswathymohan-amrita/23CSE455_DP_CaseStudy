index 0000000..f6e85ce
--- /dev/null
+++ b/src/lib/access/policy.ts
@@ -0,0 +1,28 @@
+import { AccessRule, PremiumContentRule } from "./rules"
+import {
+  ALLOW,
+  type AccessCheckedShow,
+  type AccessContext,
+  type AccessDecision,
+} from "./types"
+
+/** Links the rules in order and returns the head of the chain (null for no rules). */
+export function buildAccessChain(rules: AccessRule[]): AccessRule | null {
+  const [head, ...rest] = rules
+  if (!head) return null
+  rest.reduce<AccessRule>((link, rule) => link.setNext(rule), head)
+  return head
+}
+
+/** The rule order used by the application. */
+export function contentAccessChain(): AccessRule | null {
+  return buildAccessChain([new PremiumContentRule()])
+}
+
+export function checkAccess(
+  show: AccessCheckedShow,
+  ctx: AccessContext,
+  chain: AccessRule | null = contentAccessChain()
+): AccessDecision {
+  return chain ? chain.check(show, ctx) : ALLOW
+}
diff --git a/src/lib/access/rules.ts b/src/lib/access/rules.ts
new file mode 100644
index 0000000..64ba630
--- /dev/null
+++ b/src/lib/access/rules.ts
@@ -0,0 +1,53 @@
+import { PREMIUM_CONTENT_MIN_TIER } from "@/config/plan-catalog"
+import {
+  ALLOW,
+  type AccessCheckedShow,
+  type AccessContext,
+  type AccessDecision,
+} from "./types"
+
+/**
+ * Chain of Responsibility: each rule either denies access (and stops the chain) or
+ * passes the request to the next rule. A chain with no denial allows the title.
+ */
+export abstract class AccessRule {
+  private next: AccessRule | null = null
+
+  /** Links `rule` after this one and returns it, so links can be chained. */
+  setNext(rule: AccessRule): AccessRule {
+    this.next = rule
+    return rule
+  }
+
+  check(show: AccessCheckedShow, ctx: AccessContext): AccessDecision {
+    const denial = this.evaluate(show, ctx)
+    if (denial) return denial
+    return this.next ? this.next.check(show, ctx) : ALLOW
+  }
+
+  /** Return a denial, or null to pass the request on. */
+  protected abstract evaluate(
+    show: AccessCheckedShow,
+    ctx: AccessContext
+  ): AccessDecision | null
+}
+
+/** CH01: premium titles need a plan whose tier unlocks premium content. */
+export class PremiumContentRule extends AccessRule {
+  constructor(private readonly minTier: number = PREMIUM_CONTENT_MIN_TIER) {
+    super()
+  }
+
+  protected evaluate(
+    show: AccessCheckedShow,
+    ctx: AccessContext
+  ): AccessDecision | null {
+    if (!show.isPremium || ctx.planTier >= this.minTier) return null
+    return {
+      allowed: false,
+      reason: "PREMIUM_REQUIRED",
+      message: "This title is included with Standard, Premium and Ultra plans.",
+      visibility: "locked",
+    }
+  }
+}
