+package com.elearning.service;
+import com.elearning.model.*; import com.elearning.repository.CourseRepository; import com.elearning.repository.QuizRepository; import org.springframework.http.HttpStatus; import org.springframework.stereotype.Service; import org.springframework.web.server.ResponseStatusException; import java.util.List;
+@Service public class QuizService { private final QuizRepository quizzes; private final CourseRepository courses; public QuizService(QuizRepository q,CourseRepository c){quizzes=q;courses=c;}
+ public Quiz createQuiz(Long courseId,Long instructorId,String title,List<Question> questions){Course course=courses.findById(courseId).orElseThrow(()->new ResponseStatusException(HttpStatus.NOT_FOUND));if(course.getInstructor()==null||instructorId==null||!instructorId.equals(course.getInstructor().getId()))throw new ResponseStatusException(HttpStatus.FORBIDDEN);if(title==null||title.isBlank()||questions==null||questions.isEmpty())throw new ResponseStatusException(HttpStatus.BAD_REQUEST);Quiz quiz=new Quiz(title.trim(),course);for(Question x:questions){if(x.getPrompt()==null||x.getPrompt().isBlank()||x.getCorrectAnswer()==null||x.getCorrectAnswer().isBlank()||!Double.isFinite(x.getPoints())||x.getPoints()<=0)throw new ResponseStatusException(HttpStatus.BAD_REQUEST);x.setQuiz(quiz);}quiz.setQuestions(questions);return quizzes.save(quiz);}
+ public List<Quiz> quizzesForCourse(Long id){if(!courses.existsById(id))throw new ResponseStatusException(HttpStatus.NOT_FOUND);return quizzes.findByCourseId(id);}}

