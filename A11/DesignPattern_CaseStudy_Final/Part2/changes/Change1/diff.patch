+package com.elearning.controller;
+import com.elearning.model.*; import com.elearning.service.QuizService; import org.springframework.web.bind.annotation.*; import java.util.List;
+@RestController @RequestMapping("/api") public class QuizController {private final QuizService service;public QuizController(QuizService s){service=s;}
+ @PostMapping("/courses/{courseId}/quizzes") public QuizView create(@PathVariable Long courseId,@RequestBody CreateQuizRequest r){List<Question> qs=r.questions().stream().map(x->new Question(x.prompt(),x.correctAnswer(),x.points())).toList();return QuizView.from(service.createQuiz(courseId,r.instructorId(),r.title(),qs));}
+ @GetMapping("/courses/{courseId}/quizzes") public List<QuizView> list(@PathVariable Long courseId){return service.quizzesForCourse(courseId).stream().map(QuizView::from).toList();}
+ public record CreateQuizRequest(Long instructorId,String title,List<QuestionRequest> questions){} public record QuestionRequest(String prompt,String correctAnswer,double points){} public record QuizView(Long id,String title,List<QuestionView> questions){static QuizView from(Quiz q){return new QuizView(q.getId(),q.getTitle(),q.getQuestions().stream().map(x->new QuestionView(x.getId(),x.getPrompt(),x.getPoints())).toList());}} public record QuestionView(Long id,String prompt,double points){}}
